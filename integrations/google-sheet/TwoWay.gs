/** @OnlyCurrentDoc */
// Optional two-way prototype: install ALONE in a NEW admin-only workbook.
// Worklogs is the server view. Changes contains explicit drafts. Only READY drafts
// are sent; removing spreadsheet rows NEVER deletes worklogs from the server.
var WB_SOURCE=['Employee ID','Employee','Date','Project','Subtask','Description','Hours','Revision','Project index','Subtask index','Has subtasks'];
var WB_QUEUE=['State','Action','Employee ID','Date','Project','Subtask','Description','Hours','Status','Draft ID','Target','Request ID'];
function wbText(v){return String(v==null?'':v);}
function wbLiteral(v){var s=wbText(v);return /^[\s]*[=+@\-']/.test(s)?"'"+s:s;}
function wbDay(v){if(v instanceof Date)return Utilities.formatDate(v,'Asia/Kolkata','yyyy-MM-dd');var s=wbText(v);if(!/^\d{4}-\d{2}-\d{2}$/.test(s))throw Error('Date must be YYYY-MM-DD');return s;}
function wbFlatten(snapshot){
 if(!snapshot||!Array.isArray(snapshot.reports)||!Array.isArray(snapshot.employees))throw Error('Invalid snapshot');var out=[];
 snapshot.reports.forEach(function(r){r.rows.forEach(function(x,i){var subs=Array.isArray(x.subs)?x.subs:[];
 out.push([wbText(r.employee_id),wbText(r.name),wbDay(r.day),wbText(x.project),'',wbText(x.desc),subs.length?'':Number(x.hours||0),wbText(r.revision),i,'',subs.length>0]);
 subs.forEach(function(s,j){out.push([wbText(r.employee_id),wbText(r.name),wbDay(r.day),wbText(x.project),wbText(s.title),wbText(s.desc),Number(s.hours||0),wbText(r.revision),i,j,false]);});});});return out;
}
function wbTarget(action,r){return {action:action,employee:wbText(r[0]),day:wbDay(r[2]),revision:wbText(r[7]),main:r[8]===''?null:Number(r[8]),sub:r[9]===''?null:Number(r[9]),hasSubs:r[10]===true,project:wbText(r[3])};}
function wbDraft(t,r,id){return ['DRAFT',t.action.toUpperCase(),t.employee,t.day,r?r[3]:'',r?r[4]:'',r?r[5]:'',r?r[6]:'','Review, then set State to READY',id,JSON.stringify(t),''];}
function wbPayload(r){
 var t;try{t=JSON.parse(wbText(r[10]));}catch(e){throw Error('Missing draft target; use the Worklog sync menu');}
 if(!/^[1-9][0-9]*$/.test(t.employee)||!/^\d+$/.test(t.revision)||!['create','update','delete'].includes(t.action))throw Error('Invalid draft target');
 if(wbText(r[1]).toLowerCase()!==t.action||wbText(r[2])!==t.employee||wbDay(r[3])!==t.day)throw Error('Action, employee and date cannot change; create a new draft');
 if(t.action!=='create'&&(!Number.isInteger(t.main)||t.main<0||(t.sub!==null&&(!Number.isInteger(t.sub)||t.sub<0))))throw Error('Invalid worklog target');
 var f={};if(t.action!=='delete'){if(t.sub!==null&&wbText(r[4])!==t.project)throw Error('Edit the parent row to change its project');if(t.sub===null&&wbText(r[5]))throw Error('Subtask title is not editable on a project row');if(t.hasSubs&&r[7]!=='')throw Error('Project hours come from its subtasks');if(t.sub!==null)f.title=wbText(r[5]);else f.project=wbText(r[4]);f.desc=wbText(r[6]);if(!t.hasSubs){if(r[7]===''||!Number.isFinite(Number(r[7])))throw Error('Enter numeric hours (zero for managers/admins)');f.hours=Number(r[7]);}}
 return {p_action:t.action,p_employee:t.employee,p_day:t.day,p_revision:t.revision,p_main:t.main,p_sub:t.sub,p_fields:f};
}
function wbFingerprint(r){var text=JSON.stringify(r.slice(1,8).map(function(v){return v instanceof Date?wbDay(v):v;}));return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');}
// Adapter core persists the exact request BEFORE HTTP. Retries never send newer cell contents.
// Every response is located by draft ID, not row number, to tolerate whole-row sorting.
function wbProcess(a){var rows=a.rows(),counts={},results=[];rows.forEach(function(r){var id=wbText(r[9]);if(id)counts[id]=(counts[id]||0)+1;});
 rows.forEach(function(r){if(r[0]!=='READY')return;var id=wbText(r[9]);if(!id||counts[id]!==1){results.push('Duplicate or missing draft ID; no write sent');return;}var j=a.getJournal(id);
 var latest=a.find(id);if(!latest||latest[0]!=='READY'){results.push('Draft no longer READY '+id);return;}
 if(!j&&wbFingerprint(latest)!==wbFingerprint(r)){a.write(id,{state:'REVIEW',status:'Draft changed while earlier requests ran; review before setting READY again'});results.push('Draft changed '+id);return;}
 try{if(!j){if(r[11])throw Error('This request was already processed; create a fresh draft');j={request:a.uuid(),payload:wbPayload(r),fingerprint:wbFingerprint(r)};a.saveJournal(id,j);a.write(id,{request:j.request,status:'Sending reviewed draft'});}
 var answer=a.mutate(j.request,j.payload);if(!answer||typeof answer.revision!=='string')throw Error('Uncertain response; retry will use the same request ID');
 var current=a.find(id);if(current){var changed=wbFingerprint(current)!==j.fingerprint||current[0]!=='READY';a.write(id,{state:changed?'REVIEW':'APPLIED',request:j.request,status:changed?'Original request applied; cells changed meanwhile. Review and create a new draft.':'Applied; revision '+answer.revision});}
 a.removeJournal(id);results.push('Applied '+id);
 }catch(e){var permanent=e.httpStatus>=400&&e.httpStatus<500&&e.httpStatus!==408&&e.httpStatus!==429;a.write(id,{state:permanent?'CONFLICT':j?'READY':'ERROR',status:permanent?'Rejected: '+e.message:j?'Pending: '+e.message:e.message});results.push('Not applied '+id);}});return results;
}
function onOpen(){SpreadsheetApp.getUi().createMenu('Worklog sync').addItem('Connect this NEW workbook','wbConnect').addItem('Choose month / refresh','wbChooseMonth').addSeparator().addItem('Edit selected worklog','wbQueueEdit').addItem('Delete selected worklog','wbQueueDelete').addItem('Create worklog','wbQueueCreate').addItem('Send READY drafts','wbSend').addSeparator().addItem('Start scheduled sync','wbStart').addItem('Stop scheduled sync','wbStop').addToUi();}
function wbProps(){return PropertiesService.getScriptProperties();}
function wbBook(){var s=SpreadsheetApp.getActiveSpreadsheet();if(!s||wbProps().getProperty('WB_SHEET')!==s.getId())throw Error('Connect this dedicated workbook first');return s;}
function wbConfig(){var p=wbProps(),c={url:p.getProperty('WB_URL'),key:p.getProperty('WB_KEY'),token:p.getProperty('WB_TOKEN')};if(!c.url||!c.key||!c.token)throw Error('Worklog sync is not connected');return c;}
function wbRpc(name,args,c){if(!c){wbBook();c=wbConfig();}var body=Object.assign({},args,{p_token:c.token});var r=UrlFetchApp.fetch(c.url+'/rest/v1/rpc/'+name,{method:'post',contentType:'application/json',muteHttpExceptions:true,headers:{apikey:c.key,Authorization:'Bearer '+c.key},payload:JSON.stringify(body)});if(r.getResponseCode()>=300){var e=Error('Supabase rejected the request');try{e.message=JSON.parse(r.getContentText()).message||e.message;}catch(ignore){}e.httpStatus=r.getResponseCode();throw e;}return JSON.parse(r.getContentText());}
function wbLock(fn){var l=LockService.getScriptLock();if(!l.tryLock(25000))throw Error('Another sync is running');try{return fn();}finally{l.releaseLock();}}
function wbAsk(title,text){var u=SpreadsheetApp.getUi(),r=u.prompt(title,text,u.ButtonSet.OK_CANCEL);return r.getSelectedButton()===u.Button.OK?r.getResponseText().trim():null;}
function wbConnect(){var ss=SpreadsheetApp.getActiveSpreadsheet(),p=wbProps();if(p.getProperty('WB_SHEET')&&p.getProperty('WB_SHEET')!==ss.getId())throw Error('Do not reuse credentials in another workbook');if(p.getProperty('WB_SHEET'))throw Error('Already connected. Use a new workbook to change connections; keep pending drafts with their original server.');if(!p.getProperty('WB_SHEET')&&ss.getSheets().some(function(s){return s.getLastRow()>0;}))throw Error('Start with a new empty workbook; existing sheets will not be replaced');
 var url=wbAsk('Staging Supabase URL','HTTPS project URL, no path');if(url===null)return;url=url.replace(/\/+$/,'');if(!/^https:\/\/[a-z0-9.-]+(?::[0-9]+)?$/i.test(url))throw Error('Invalid HTTPS URL');var key=wbAsk('Public anon key','Never enter a service-role key');if(key===null)return;var token=wbAsk('Dedicated worklog write token','Separate admin-owned writeback token, not the read-only export token');if(token===null)return;if(!key||token.length<32)throw Error('A public key and write token of at least 32 characters are required');
 wbLock(function(){var month=Utilities.formatDate(new Date(),'Asia/Kolkata','yyyy-MM');wbRpc('eod_sheet_snapshot',{p_month:month},{url:url,key:key,token:token});p.setProperties({WB_SHEET:ss.getId(),WB_URL:url,WB_KEY:key,WB_TOKEN:token,WB_MONTH:month});wbSetup();wbRefresh();});}
function wbSheet(name,headers){var ss=wbBook(),s=ss.getSheetByName(name);if(!s){s=ss.insertSheet(name);s.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold');s.setFrozenRows(1);}return s;}
function wbSetup(){wbBook().setSpreadsheetTimeZone('Asia/Kolkata');var w=wbSheet('Worklogs',WB_SOURCE),q=wbSheet('Changes',WB_QUEUE);wbSheet('People',['Employee ID','Name','Role']);w.hideColumns(8,4);q.hideColumns(10,3);w.getRange(2,1,w.getMaxRows()-1,1).setNumberFormat('@');w.getRange(2,3,w.getMaxRows()-1,1).setNumberFormat('@');q.getRange(2,3,q.getMaxRows()-1,2).setNumberFormat('@');[w,q].forEach(function(s){s.setColumnWidths(1,Math.min(s.getMaxColumns(),8),145);});w.setColumnWidth(6,360);q.setColumnWidth(7,360);q.setColumnWidth(9,380);q.getRange(2,1,q.getMaxRows()-1,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['DRAFT','READY'],true).setAllowInvalid(true).build());
 [w,wbBook().getSheetByName('People')].forEach(function(s){if(!s.getProtections(SpreadsheetApp.ProtectionType.SHEET).length)s.protect().setDescription('Server view; use Worklog sync to create a draft').setWarningOnly(true);});}
function wbWriteView(name,headers,rows){var s=wbSheet(name,headers);if(s.getMaxRows()<rows.length+1)s.insertRowsAfter(s.getMaxRows(),rows.length+1-s.getMaxRows());if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,headers.length).clearContent();if(rows.length)s.getRange(2,1,rows.length,headers.length).setValues(rows.map(function(r){return r.map(function(v){return typeof v==='string'?wbLiteral(v):v;});}));return s;}
function wbRefresh(){var month=wbProps().getProperty('WB_MONTH');if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(month||''))throw Error('Choose a month first');var snap=wbRpc('eod_sheet_snapshot',{p_month:month});wbWriteView('Worklogs',WB_SOURCE,wbFlatten(snap));wbWriteView('People',['Employee ID','Name','Role'],snap.employees.map(function(e){return [wbText(e.id),e.name,e.role];}));return snap;}
function wbChooseMonth(){var m=wbAsk('Worklog month','YYYY-MM. Your Changes drafts are preserved.');if(m===null)return;if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(m))throw Error('Use YYYY-MM');wbLock(function(){wbBook();wbProps().setProperty('WB_MONTH',m);wbRefresh();});}
function wbAppendDraft(t,r){var s=wbSheet('Changes',WB_QUEUE),v=wbDraft(t,r,Utilities.getUuid()),n=s.getLastRow()+1;if(s.getMaxRows()<n)s.insertRowsAfter(s.getMaxRows(),Math.max(100,n-s.getMaxRows()));s.getRange(n,3,1,2).setNumberFormat('@');s.getRange(n,1,1,v.length).setValues([v.map(function(x){return typeof x==='string'?wbLiteral(x):x;})]);wbBook().setActiveSheet(s);}
function wbQueue(action){wbLock(function(){var ss=wbBook(),s=ss.getActiveSheet(),r=s.getActiveRange();if(s.getName()!=='Worklogs'||r.getRow()<2||r.getNumRows()!==1)throw Error('Select one worklog row in Worklogs');var v=s.getRange(r.getRow(),1,1,WB_SOURCE.length).getValues()[0];if(!v[0])throw Error('Select a populated worklog');var t=wbTarget(action,v);if(action==='delete'&&t.hasSubs&&SpreadsheetApp.getUi().alert('Delete project and its subtasks?','Sending this draft removes the project and all its subtasks.',SpreadsheetApp.getUi().ButtonSet.OK_CANCEL)!==SpreadsheetApp.getUi().Button.OK)return;wbAppendDraft(t,v);});}
function wbQueueEdit(){wbQueue('update');}function wbQueueDelete(){wbQueue('delete');}
function wbQueueCreate(){var emp=wbAsk('Employee ID','Use an ID from People');if(emp===null)return;var day=wbAsk('Work date','YYYY-MM-DD (today or previous 7 days)');if(day===null)return;day=wbDay(day);wbLock(function(){wbBook();var s=wbRpc('eod_sheet_snapshot',{p_month:day.slice(0,7)});if(!s.employees.some(function(e){return wbText(e.id)===emp;}))throw Error('Choose an active employee');var r=s.reports.find(function(r){return wbText(r.employee_id)===emp&&wbDay(r.day)===day;});var rev=r?r.revision:(s.revisions||{})[emp+'/'+day]||'0';wbAppendDraft({action:'create',employee:emp,day:day,revision:wbText(rev),main:null,sub:null,hasSubs:false},null);});}
function wbAdapter(){var s=wbSheet('Changes',WB_QUEUE),p=wbProps();function rows(){return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,WB_QUEUE.length).getValues();}function locate(id){var all=rows(),found=[];all.forEach(function(r,i){if(wbText(r[9])===id)found.push({row:r,index:i+2});});return found.length===1?found[0]:null;}
 return {rows:rows,find:function(id){var x=locate(id);return x&&x.row;},uuid:function(){return Utilities.getUuid();},getJournal:function(id){var v=p.getProperty('WB_REQUEST_'+id);return v?JSON.parse(v):null;},saveJournal:function(id,v){p.setProperty('WB_REQUEST_'+id,JSON.stringify(v));},removeJournal:function(id){p.deleteProperty('WB_REQUEST_'+id);},write:function(id,v){var x=locate(id);if(!x)return;if(v.state)s.getRange(x.index,1).setValue(v.state);if(v.status)s.getRange(x.index,9).setValue(wbLiteral(v.status));if(v.request)s.getRange(x.index,12).setValue(v.request);SpreadsheetApp.flush();},mutate:function(id,v){return wbRpc('eod_sheet_mutate',Object.assign({p_request:id},v));}};}
function wbSync(){return wbLock(function(){wbBook();var result=wbProcess(wbAdapter());wbRefresh();return result;});}
function wbSend(){var ready=wbAdapter().rows().filter(function(r){return r[0]==='READY';}),deletes=ready.filter(function(r){return r[1]==='DELETE';}).length,u=SpreadsheetApp.getUi();if(!ready.length){u.alert('No READY drafts. Review Changes and set State to READY.');return;}if(u.alert('Send reviewed worklog changes?',ready.length+' draft(s), including '+deletes+' deletion(s). Changes are audited. Conflicts stop a draft.',u.ButtonSet.OK_CANCEL)!==u.Button.OK)return;wbSync();}
function wbStart(){wbBook();wbConfig();wbLock(function(){wbStop();ScriptApp.newTrigger('wbSync').timeBased().everyMinutes(1).create();});SpreadsheetApp.getActiveSpreadsheet().toast('Only READY drafts are sent automatically. DRAFT rows stay untouched.','Worklog sync',8);}
function wbStop(){ScriptApp.getProjectTriggers().forEach(function(t){if(t.getHandlerFunction()==='wbSync')ScriptApp.deleteTrigger(t);});}
